# 依赖
node_modules/

# 运行时数据（首次启动自动创建；含 token、SSH 凭据、TLS 私钥，绝不能入库）
data/*
!data/config.example.json

# 日志
*.log

# 前端构建产物（npm run build:web 重新生成）
web/dist/

