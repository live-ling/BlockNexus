# 依赖
node_modules/

# 运行时数据（含真实凭据：token、SSH 密码、TLS 私钥 —— 绝不能入库）
data/

# 日志
*.log

# 前端构建产物
web/dist/

# 本地构建 / 签名产物（build-exe.ps1 可重新生成；自签证书在别处无意义）
/BlockNexus.exe
/BlockNexus.exe.config
/BlockNexus.cer
/Microsoft.Web.WebView2.Core.dll
/Microsoft.Web.WebView2.WinForms.dll
/WebView2Loader.dll
/runtimes/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# ZCode 会话工作区
.zcode/
.zcodeignore

# 外壳目录标记（build-exe.ps1 写入，外壳目录就是仓库根）
/root.txt

# Release 产物
/release/

# 官网（另一个 agent 开发中，独立管理，不入本仓库）
/website/
